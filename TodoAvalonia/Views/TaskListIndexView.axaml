<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TodoAvalonia.ViewModels"
             xmlns:controls="using:TodoAvalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TodoAvalonia.Views.TaskListIndexView"
             x:DataType="vm:TaskListIndexViewModel"
             d:DataContext="{x:Static vm:DesignData.DesignTaskLists}">
    <ScrollViewer Margin="64 0">
        <ScrollViewer.OpacityMask>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="Transparent" Offset="0.0"/>
                <GradientStop Color="Black" Offset="0.08"/>
                <GradientStop Color="Black" Offset="0.92"/>
                <GradientStop Color="Transparent" Offset="1.0"/>
            </LinearGradientBrush>
        </ScrollViewer.OpacityMask>
        <ItemsControl Margin="16 48" ItemsSource="{Binding ListItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:ReorderableMasonryGrid MinItemWidth="256" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <controls:ItemsTemplateSelector />
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
