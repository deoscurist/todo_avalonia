<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:TodoAvalonia.Models"
             xmlns:vm="clr-namespace:TodoAvalonia.ViewModels"
             xmlns:lang="using:TodoAvalonia.Langs"
             xmlns:converters="using:TodoAvalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="200"
             x:Class="TodoAvalonia.Views.TaskListCardView"
             d:DataContext="{x:Static vm:DesignData.DesignTaskListItem}"
             x:DataType="vm:TaskListViewModel">
    <Border
        Classes="TaskCard"
        Tapped="Border_Tapped"
        Margin="8"
        Padding="8">
        <Border.Effect>
            <DropShadowEffect Opacity="0.15" Color="Black"></DropShadowEffect>
        </Border.Effect>
        <Grid RowDefinitions="32,*">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right">
                <Button Width="32" Height="32" Classes="AppButton" Tapped="MenuButton_Tapped">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem
                                Foreground="DeepPink"
                                Command="{Binding EditCommand}"
                                Header="{lang:Tr Card.Edit}"
                                >
                                <MenuItem.Icon>                                                                                                                                                                                          
                                    <PathIcon Data="{StaticResource Edit}" Foreground="DeepPink"/>                                                                                                                                                            
                                </MenuItem.Icon>  
                            </MenuItem>
                            <MenuItem
                                Foreground="DeepPink"
                                Command="{Binding DeleteCommand}"
                                Header="{lang:Tr Card.Delete}"
                                >
                                <MenuItem.Icon>                                                                                                                                                                                          
                                    <PathIcon Data="{StaticResource Delete}" Foreground="DeepPink"/>                                                                                                                                                            
                                </MenuItem.Icon>  
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <PathIcon Data="{StaticResource DropMenu}" Width="16" Height="16" Foreground="DeepPink"/>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Grid.Row="1" Margin="8">
                <TextBlock Classes="Heading" Margin="0 0 0 10" FontSize="24" TextWrapping="Wrap" Text="{Binding Title}" />
                <Grid ColumnDefinitions="*,Auto,*">
                    <TextBlock Classes="Meta" FontSize="12">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static converters:LocalizedKeyConverter.Instance}">
                                <Binding Path="Status" />
                                <Binding Path="CurrentCode" Source="{x:Static lang:Localizer.Instance}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Classes="Meta" HorizontalAlignment="Right" Grid.Column="2" FontSize="12" Text="{Binding ExpiredAt}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>