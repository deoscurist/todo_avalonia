<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TodoAvalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TodoAvalonia.Views.CreateTaskView"
             x:DataType="vm:CreateTaskViewModel">
    <Border
        Margin="8"
        Padding="16"
        CornerRadius="8"
        BorderBrush="#90FF1493"
        BorderThickness="1"
        PointerPressed="Border_PointerPressed"
        Background="#90FFC0CB">
        <Border.Effect>
            <DropShadowEffect Opacity="0.15" Color="Black"></DropShadowEffect>
        </Border.Effect>
        <WrapPanel Orientation="Horizontal" ItemsAlignment="Center">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 0 8 0" FontSize="24" FontFamily="{StaticResource Caveat}">+</TextBlock>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{StaticResource Caveat}" FontSize="24">Add task</TextBlock>
        </WrapPanel>
    </Border>
</UserControl>
