<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="using:TodoAvalonia.Langs"
             xmlns:vm="clr-namespace:TodoAvalonia.ViewModels"
             xmlns:converters="using:TodoAvalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:TaskListFilterViewModel"
             x:Class="TodoAvalonia.Views.TaskListFilterView">
    <UserControl.DataContext>                                                                                                                                                                                    
        <vm:TaskListFilterViewModel/>                                                                                                                                                                            
    </UserControl.DataContext>  
    <UserControl.Resources>
        <converters:TaskListFilterSelectedConverter x:Key="Selected"/>
    </UserControl.Resources>
    <Border
        Padding="8"
        BorderBrush="#88FFFFFF"
        Background="#55FFFFFF"
        BorderThickness="1"
        CornerRadius="48"
        Height="48">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <!-- @todo -->
            <!-- <StackPanel Orientation="Horizontal" Spacing="8"> -->
            <!--     <TextBox  -->
            <!--         CornerRadius="24"  -->
            <!--         BorderBrush="#FF999999" -->
            <!--         Background="#FFFFFFFF" -->
            <!--         BorderThickness="1" -->
            <!--         FontFamily="{StaticResource Caveat}" -->
            <!--         Height="24"  -->
            <!--         PlaceholderText="{lang:Tr Filter.SearchPlaceholder}" -->
            <!--         MinWidth="240"/> -->
            <!-- </StackPanel> -->
            <StackPanel Classes="Filter" Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8" Margin="0 0 8 0">
                <TextBlock 
                    FontFamily="{StaticResource Caveat}" 
                    Text="{lang:Tr Filter.ReorderBy}"
                    VerticalAlignment="Center"
                    />
                <Button
                    Classes.Selected="{Binding FilterBy, Converter={StaticResource Selected}, ConverterParameter=status}"
                    Command="{Binding SetFilterByCommand}" 
                    CommandParameter="status" 
                    FontSize="12" 
                    Padding="0" 
                    VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Status}" Width="24" Height="24"/>
                </Button>
                <Button 
                    Classes.Selected="{Binding FilterBy, Converter={StaticResource Selected}, ConverterParameter=created}"
                    Command="{Binding SetFilterByCommand}" 
                    CommandParameter="created" 
                    FontSize="12" 
                    Padding="0" 
                    VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource CreatedAt}" Width="24" Height="24"/>
                </Button>
                <Button 
                    Classes.Selected="{Binding FilterBy, Converter={StaticResource Selected}, ConverterParameter=expired}"
                    Command="{Binding SetFilterByCommand}" 
                    CommandParameter="expired" 
                    FontSize="12" 
                    Padding="0" 
                    VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource ExpiredAt}" Width="24" Height="24"/>
                </Button>
                <Separator Height="NaN" Width="1"></Separator>
                <Button
                    Command="{Binding ReorderAllCommand}" 
                    CommandParameter="asc"
                    FontSize="12" 
                    Padding="0" 
                    VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource SortUp}" Width="24" Height="24"/>
                </Button>
                <Button
                    Command="{Binding ReorderAllCommand}" 
                    CommandParameter="desc"  
                    FontSize="12" 
                    Padding="0" 
                    VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource SortDown}" Width="24" Height="24"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
