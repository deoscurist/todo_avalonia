<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TodoAvalonia.App"
             xmlns:local="using:TodoAvalonia"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Assets/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <FontFamily x:Key="Birthstone">avares://TodoAvalonia/Assets/Fonts#Birthstone</FontFamily>
        <FontFamily x:Key="GreatVibes">avares://TodoAvalonia/Assets/Fonts#Great Vibes</FontFamily>
        <FontFamily x:Key="Caveat">avares://TodoAvalonia/Assets/Fonts#Caveat</FontFamily>
        <FontFamily x:Key="BadScript">avares://TodoAvalonia/Assets/Fonts#Bad Script</FontFamily>
    </Application.Resources>    

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TodoAvalonia/Assets/Styles/Valentine.axaml" />
    </Application.Styles>
</Application>